{
  "name": "local_audit",
  "version": "1.0",
  "description": "本地资料复盘：文件读取 → 数据库查询 → 报告",
  "required_tools": ["file_reader", "sql_query"],
  "parameters": {
    "query": {"type": "string", "required": true},
    "file_path": {"type": "string", "default": "demo_research_note.md"}
  },
  "steps": [
    {
      "tool_name": "file_reader",
      "goal": "读取本地工作区文档",
      "arguments": {
        "path": "{{parameters.file_path}}",
        "max_chars": 4000
      }
    },
    {
      "tool_name": "sql_query",
      "goal": "查询本地数据库中的文档元数据",
      "arguments": {
        "query": "SELECT id, title, category FROM documents",
        "limit": 10
      }
    },
    {
      "tool_name": "report_writer",
      "goal": "整合本地资料生成审计报告",
      "arguments": {}
    }
  ]
}
