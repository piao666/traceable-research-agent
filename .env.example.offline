# Traceable Research Agent — isolated offline/development profile
# Copy this file to .env only for local development, CI, or demonstrations.
RESEARCH_PROFILE=offline
OFFLINE_MODE=true
EXTERNAL_TOOLS_DEFAULT_MODE=mock
ALLOW_MOCK_FALLBACK=false
LLM_PROVIDER=deterministic
LLM_PLANNER_ENABLED=false
LLM_PLANNER_MODE=deterministic
REPORT_GENERATION_MODE=deterministic
EXECUTION_MODE=planned
REACT_ENABLED=false
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_ENGINE_VERSION=v2
MCP_BRIDGE_FAKE_MODE=true
AUTH_ENABLED=false
