# =============================================================================
# Traceable Research Agent — Environment Configuration
# Copy to .env and fill in your values.
# See README.md for detailed explanations of each section.
# =============================================================================

# ---------------------------------------------------------------------------
# Core Runtime
# ---------------------------------------------------------------------------
APP_PHASE=traceable-research-agent
SERVICE_NAME=traceable-research-agent
API_PREFIX=/api
OFFLINE_MODE=false
EXTERNAL_TOOLS_DEFAULT_MODE=real
ALLOW_MOCK_FALLBACK=false

# ---------------------------------------------------------------------------
# Optional API authentication
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
DEMO_API_KEY=
AUTH_HEADER_NAME=X-API-Key
ALLOW_AUTH_DISABLED_IN_DEV=true
ASYNC_RUN_ENABLED=true
ASYNC_RUN_POLL_INTERVAL_SECONDS=1

# ---------------------------------------------------------------------------
# Execution Mode
#   EXECUTION_MODE: planned (stable default) | react (dynamic decision-making)
# ---------------------------------------------------------------------------
EXECUTION_MODE=planned
PARALLEL_EXECUTION_ENABLED=false
PARALLEL_MAX_WORKERS=3
PARALLEL_GROUP_STRATEGY=independent_tools
PARALLEL_TIMEOUT_SECONDS=60

# ReAct settings (only relevant when EXECUTION_MODE=react)
REACT_ENABLED=true
REACT_MAX_STEPS=8
REACT_SAME_TOOL_MAX_CALLS=3
REACT_LLM_PROVIDER=qwen
REACT_LLM_MODEL=qwen-plus
REACT_DECISION_STRICT_JSON=true
REACT_FALLBACK_TO_PLANNED=true
REACT_FINISH_ON_INVALID_DECISION=true

# Deep Research (Phase 5 iterative deepening)
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_MAX_DEPTH=2
DEEP_RESEARCH_BREADTH=3

# Memory (Phase 5 LLM distillation)
MEMORY_LLM_EXTRACTION_ENABLED=false

# Academic search (Phase 6)
SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------------------------
# LLM Provider
#   LLM_PROVIDER: deterministic | qwen | deepseek
#   REPORT_GENERATION_MODE: deterministic (offline-safe) | llm
# ---------------------------------------------------------------------------
LLM_PLANNER_ENABLED=false
REPORT_GENERATION_MODE=deterministic
LLM_PROVIDER=qwen
LLM_PLANNER_MODE=auto
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_STRICT_JSON=true

# API keys (fill the one matching LLM_PROVIDER)
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ---------------------------------------------------------------------------
# Tools — GitHub
# ---------------------------------------------------------------------------
GITHUB_TOOL_DEFAULT_MODE=public_api
GITHUB_TOKEN=
GITHUB_PUBLIC_API_ENABLED=true
GITHUB_SEARCH_CACHE_ENABLED=true
GITHUB_SEARCH_CACHE_PATH=workspace/cache/github_search_cache.json
GITHUB_SEARCH_CACHE_TTL_SECONDS=3600
GITHUB_PUBLIC_API_TIMEOUT_SECONDS=10
GITHUB_PUBLIC_API_MAX_RETRIES=2
GITHUB_PUBLIC_API_FALLBACK_TO_MOCK=false

# ---------------------------------------------------------------------------
# Tools — Tavily Search
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_SEARCH_ENABLED=true
TAVILY_DEFAULT_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=15
TAVILY_MAX_RETRIES=2
TAVILY_FALLBACK_TO_MOCK=false

# ---------------------------------------------------------------------------
# Tools — File Reader
#   FILE_READER_ALLOWED_ROOTS: semicolon-separated paths (relative to repo root)
# ---------------------------------------------------------------------------
FILE_READER_ALLOWED_ROOTS=workspace/docs
FILE_READER_HITL_OUTSIDE_ALLOWED_ROOTS=true

# ---------------------------------------------------------------------------
# MCP & Source Pack Bridge
# ---------------------------------------------------------------------------
MCP_READONLY_MODE=true
MCP_ADAPTER_MODE=github_tavily_readonly
MCP_ALLOW_WRITE_TOOLS=false
MCP_REMOTE_REGISTRY_ENABLED=false
MCP_REMOTE_SERVERS=
MCP_REMOTE_REGISTRATION_ATTEMPTS=5
MCP_REMOTE_REGISTRATION_RETRY_SECONDS=1

# Channel servers (JSON arrays, keep on one line in .env)
MCP_CHANNEL_READONLY_SERVERS=
MCP_CHANNEL_INTERACTIVE_SERVERS=
MCP_CHANNEL_WRITE_SERVERS=

# Source Pack Bridge (standalone server, start via scripts/start_mcp_source_pack.ps1)
MCP_BRIDGE_HOST=127.0.0.1
MCP_BRIDGE_PORT=9001
MCP_BRIDGE_ENABLED_PROVIDERS=firecrawl,exa,context7
MCP_BRIDGE_FAKE_MODE=true
MCP_BRIDGE_TIMEOUT_SECONDS=20
MCP_BRIDGE_MAX_RESULTS=20
MCP_BRIDGE_MAX_CONTENT_CHARS=12000

# Source Pack API keys
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
CONTEXT7_API_KEY=
CONTEXT7_BASE_URL=

# ---------------------------------------------------------------------------
# Evidence & Source Policy
# ---------------------------------------------------------------------------
EVIDENCE_PIPELINE_VERSION=v2
EVIDENCE_EXTRACTOR_VERSION=v2-rule-1
EVIDENCE_ARTIFACT_ROOT=workspace/artifacts
EVIDENCE_PASSAGE_MAX_CHARS=4000
EVIDENCE_REASONING_ENABLED=true
CITATION_VALIDATION_ENABLED=true
CITATION_VALIDATION_LLM_ENABLED=false
SOURCE_POLICY_PATH=config/source_policy.v1.json

# ---------------------------------------------------------------------------
# Phase 8.1 — Source Tier Governance
# ---------------------------------------------------------------------------
DEFAULT_RETRIEVAL_PROFILE=generic
OVERSAMPLE_FACTOR=2
MAX_DISCOVERY_CANDIDATES=15
MAX_FETCH_CANDIDATES=10
MAX_REFETCH_ROUNDS=2

# ---------------------------------------------------------------------------
# Phase 8.2 — Local Fetch Hardening
# ---------------------------------------------------------------------------
WEB_FETCHER_MAX_RESPONSE_BYTES=10485760
WEB_FETCHER_CACHE_ENABLED=true
WEB_FETCHER_CACHE_TTL_SECONDS=3600
WEB_FETCHER_CACHE_DIR=workspace/cache/fetch
WEB_FETCHER_TRAFILATURA_ENABLED=true
WEB_FETCHER_PLAYWRIGHT_ENABLED=false

# ---------------------------------------------------------------------------
# Phase 8.3 — PDF Reader
# ---------------------------------------------------------------------------
PDF_READER_ENABLED=true
PDF_READER_MAX_PAGES=50
PDF_READER_MAX_RESPONSE_BYTES=52428800
PDF_READER_OCR_ENABLED=false
PDF_READER_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Streamlit Frontend
# ---------------------------------------------------------------------------
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_API_TIMEOUT_SECONDS=30
STREAMLIT_CREATE_TASK_TIMEOUT_SECONDS=120
