RESEARCH_PROFILE=deep
DEEP_RESEARCH_ENGINE_VERSION=v2

OFFLINE_MODE=false
EXTERNAL_TOOLS_DEFAULT_MODE=real
ALLOW_MOCK_FALLBACK=false

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=your-model
LLM_API_KEY=

REACT_LLM_PROVIDER=openai_compatible
REACT_LLM_MODEL=your-model
REACT_ENABLED=true

LLM_PLANNER_ENABLED=true
LLM_PLANNER_MODE=auto
REPORT_GENERATION_MODE=llm
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_STRICT_JSON=true

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_ENABLED=true
TAVILY_DEFAULT_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=30
TAVILY_MAX_RETRIES=2
TAVILY_FALLBACK_TO_MOCK=false

DEEP_RESEARCH_ENABLED=true
DEEP_RESEARCH_MAX_DEPTH=2
DEEP_RESEARCH_BREADTH=3
RESEARCH_MAX_TOOL_CALLS=80
RESEARCH_MAX_LLM_CALLS=192
RESEARCH_MAX_TOKENS=400000
RESEARCH_MAX_SECONDS=1800

EVIDENCE_PIPELINE_VERSION=v2
EVIDENCE_EXTRACTOR_VERSION=v2-rule-2
EVIDENCE_ARTIFACT_ROOT=workspace/artifacts
EVIDENCE_REASONING_ENABLED=true
CITATION_VALIDATION_ENABLED=true
CITATION_VALIDATION_LLM_ENABLED=false
SOURCE_POLICY_PATH=config/evidence_policy.v3.json

FETCH_ROUTER_ENABLED=true
FETCH_HTTP_ENABLED=true
FETCH_BROWSER_ENABLED=false
FETCH_REMOTE_EXTRACT_ENABLED=false
WEB_FETCHER_PLAYWRIGHT_ENABLED=false
WEB_FETCHER_CACHE_ENABLED=true
WEB_FETCHER_CACHE_TTL_SECONDS=3600

PDF_READER_ENABLED=true
PDF_READER_MAX_PAGES=50
PDF_READER_OCR_ENABLED=false

TRACE_DATABASE_PATH=workspace/traceable_research_agent.sqlite
DOCKER_INIT_DEMO_DATA=true

AUTH_ENABLED=false
DEMO_API_KEY=

MCP_READONLY_MODE=true
MCP_ALLOW_WRITE_TOOLS=false

FILE_READER_ALLOWED_ROOTS=workspace/docs
FILE_READER_HITL_OUTSIDE_ALLOWED_ROOTS=true
