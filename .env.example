# Traceable Research Agent — minimum real Deep Research configuration
# Copy to .env, replace the four placeholders, then run the explicit runtime
# preflight from the frontend or scripts/validate_real_runtime.py.
RESEARCH_PROFILE=deep

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=your-model
LLM_API_KEY=

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Optional local API authentication. Keep disabled for a private local demo.
AUTH_ENABLED=false
DEMO_API_KEY=
